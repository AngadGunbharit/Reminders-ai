# Copy to .env and fill in your keys.
# ANTHROPIC_API_KEY  → required for --llm mode and the voice server
# VAPI_*             → required for the voice interface (app.vapi.ai)
# SERVER_URL         → your public HTTPS URL (e.g. ngrok tunnel)

ANTHROPIC_API_KEY=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
SERVER_URL=https://your-ngrok-url.ngrok-free.app
